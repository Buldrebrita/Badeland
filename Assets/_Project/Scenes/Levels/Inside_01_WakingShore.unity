--- !u!114 &31901211
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 31901210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48fb96c4990b1cf45bcb325a59cebd06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Badeland.Runtime::Badeland.World.ReadableNote
  title: Marit's handwriting
  text: 'DAY 2.


    There are green pools all over the shore. Marit dropped her spoon into one, to see.


    It was gone in a breath. The metal went soft and pitted first, like the pool was chewing it.


    We are not going near those. Not ever.'
  radius: 3
