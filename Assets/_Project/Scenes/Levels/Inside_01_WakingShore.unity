  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48fb96c4990b1cf45bcb325a59cebd06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Badeland.Runtime::Badeland.World.ReadableNote
  title: A torn page
  text: 'DAY 1.


    We came in through the water, all of us. Nobody remembers the dark part.

    The ground is warm. It moves a little, like something asleep.


    Marit is counting the lights. She says someone must have put them here.'
  radius: 3
  readSeconds: 14
