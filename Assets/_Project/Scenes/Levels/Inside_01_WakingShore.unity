  m_Script: {fileID: 11500000, guid: 48fb96c4990b1cf45bcb325a59cebd06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Badeland.Runtime::Badeland.World.ReadableNote
  title: A page, held down by a stone
  text: 'DAY 9.


    We found the stone houses. Someone built here, long before us.

    Above every door the same spiral. An eye? A mouth?


    Marit has stopped sleeping.'
  radius: 3
  readSeconds: 14
