# Normalize line endings for text
* text=auto

# Unity YAML assets: keep LF so diffs and merges behave
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.meta text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.overrideController text eol=lf
*.lighting text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.vfx text eol=lf

# Code and docs
*.cs text diff=csharp eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.md text eol=lf
*.json text eol=lf

# ---------------------------------------------------------------
# Git LFS: large binary assets
# Run `git lfs install` once per machine before cloning or committing.
# ---------------------------------------------------------------

# 3D models and scenes
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
